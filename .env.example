# AfyaQueue Environment Configuration
# Set to 'true' to connect to the local Firebase Emulator Suite
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-afyaqueue

# Optional override for physical devices if hostUri auto-detection is not used.
# Leave blank to auto-detect your development machine's LAN IP from Expo.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=10.233.61.150

# Production Cloud Firebase Credentials (optional, leave blank when using local emulators)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
